{
  "name": "causal-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sign-token": "tsx --env-file=.env scripts/sign-token.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.0",
    "@hono/node-server": "^1.13.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@shopify/admin-api-client": "^1.1.2",
    "@vercel/otel": "^2.1.3",
    "ai": "^6.0.177",
    "hono": "^4.6.0",
    "langfuse": "^3.38.20",
    "langfuse-vercel": "^3.38.20",
    "mysql2": "^3.22.3",
    "node-cron": "^3.0.3",
    "pg": "^8.20.0",
    "resend": "^6.12.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "tsx": "^4.22.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.0.0"
}
