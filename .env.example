OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini  # legacy fallback for code paths without a persona claim
CHAT_MAX_OUTPUT_TOKENS=4096
CHAT_MESSAGE_HISTORY=50     # sliding window: keep only last N messages for LLM context (0 = unlimited)

# Per-persona provider model ids. Frontend never sees these — it sends a
# persona claim ("greenet" | "idol-3" | "desert-blue") in the service token
# and the backend resolves to one of these.
MODEL_GREENET=gpt-5            # finance / accounting
MODEL_IDOL_3=gpt-4o-mini       # general business (default)
MODEL_DESERT_BLUE=gpt-4o       # growth / marketing

LLM_PROXY_SECRET=
PORT=8080
NEXT_JS_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Web Search Agent (real-time internet search for competitor intelligence, market trends)
# Uses gpt-5-search-api which includes built-in web search via Chat Completions API
# Future: migrate to Responses API with gpt-5.5 once full SDK support is available
WEB_SEARCH_MODEL=gpt-5-search-api
WEB_SEARCH_MAX_QUERIES=5

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=notifications@yourdomain.com
COMPANY_NAME=Ovrt

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST="https://cloud.langfuse.com"

# WhatsApp Business Platform (Cloud API)
WHATSAPP_APP_SECRET=             # Meta App Secret — webhook HMAC verification (token exchange happens in the frontend)
WHATSAPP_VERIFY_TOKEN=           # arbitrary string we choose; Meta echoes it back during the GET webhook handshake
WHATSAPP_GRAPH_API_VERSION=      # e.g. v21.0 — pin a version rather than hardcoding inline everywhere

# Shopify analytics data endpoints (/shopify-data/*)
# TTL for the cached /shopify-data/customers crawl, in ms. Customer order-count /
# lifetime-value change slowly, so caching the full crawl per (org, date-range)
# makes repeat dashboard loads instant. Defaults to 300000 (5 min) if unset.
SHOPIFY_CUSTOMERS_CACHE_TTL_MS=
